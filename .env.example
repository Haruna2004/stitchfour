# Cloudflare Web Analytics beacon token (cookie-less page views).
# Copy to .env.production.local (gitignored) and fill in before `bun run deploy`.
# Empty = no beacon is loaded. Only used in production builds.
VITE_CF_BEACON_TOKEN=

# Game events via Workers Analytics Engine. Set to 1 only after enabling Analytics Engine
# and adding the EVENTS binding back to wrangler.jsonc.
VITE_GAME_EVENTS=
