{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stitchfour",
  "main": "./party/index.ts",
  "routes": [{ "pattern": "stitchfour.harunafaruk.com", "custom_domain": true }],
  "workers_dev": true,
  "compatibility_date": "2026-10-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/parties/*", "/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "StitchRoom", "class_name": "StitchRoom" },
      { "name": "Lobby", "class_name": "Lobby" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["StitchRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["Lobby"] }
  ],
  "observability": { "enabled": true }
}
